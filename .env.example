# ============================================================
# AD Support Agent — variables de entorno (Linux + Docker)
# Copia este archivo a .env y rellena los valores reales.
# Nunca subas .env a git.
# ============================================================

# --- API ---
API_KEY=cambia-esta-llave-por-algo-seguro

# --- Microsoft Entra ID / Graph ---
TENANT_ID=<tu-tenant-guid>
CLIENT_ID=<tu-client-guid>
CLIENT_SECRET=<tu-secreto-de-app>

# Grupo de aprobadores en Graph (OID)
AD_APPROVAL_GROUP_ID=<oid-del-grupo-de-aprobadores>

# Cuenta técnica para Graph (ROPC + caché silenciosa) — opcional si no usas aprobaciones Graph
APPROVAL_ACCOUNT=
APPROVAL_ACCOUNT_USERNAME=
APPROVAL_ACCOUNT_PASSWORD=

# --- Active Directory (LDAPS) — REQUERIDO para desbloqueo programado ---
AD_DOMAIN=unetrans.com.co
AD_SERVER=SIMM-PDC1.unetrans.com.co
AD_BIND_USER=sittiad@unetrans.com.co
AD_BIND_PASSWORD=S1tt1M3d3ll1n2025++

# --- Tarea diaria de desbloqueo ---
DAILY_UNLOCK_DRY_RUN=true          # true = solo lista, false = desbloquea de verdad
DAILY_UNLOCK_ENABLED=false         # true = activa desbloqueo real (solo si DRY_RUN=false)
DAILY_UNLOCK_LOG=/app/logs/daily_unlock.log

# --- Zona horaria del contenedor (para cron) ---
TZ=America/Bogota
